#
# Build the base dask-gateway image for and cluster mode.
# Target Docker image name:
# ghcr.io/rs-python/dask/dask-gateway:k8s-py<PYTHON_VERSION_BASE>-<DASK_TAG>
#

ARG PYTHON_VERSION_BASE=xxx
FROM python:${PYTHON_VERSION_BASE}-slim-bookworm

COPY ./layer-cleanup.sh /usr/local/bin/
RUN chmod 755 /usr/local/bin/layer-cleanup.sh

COPY dask-scheduler /usr/local/bin/
RUN chmod 755 /usr/local/bin/dask-scheduler
COPY dask-worker /usr/local/bin/
RUN chmod 755 /usr/local/bin/dask-worker

COPY ./requirements-k8s.txt /opt/requirements-dask.txt
COPY ./eopf-runner /opt/eopf-runner

# Do the same as in:
# https://github.com/dask/dask-gateway/blob/main/dask-gateway/Dockerfile
# https://github.com/dask/dask-gateway/blob/main/dask-gateway-server/Dockerfile

# Install tini and upgrade linux packages are updated to patch known
# vulnerabilities.
RUN apt-get update \
 && apt-get upgrade -y \
 && apt-get install -y \
        tini \
 && layer-cleanup.sh

# Install the complete dependency set resolved for this image.
RUN \
    pip install --upgrade pip && \
    pip install -r /opt/requirements-dask.txt \
    && pip check \
    && layer-cleanup.sh

# Make the EOPF runner available in the Python path
RUN python -c "import site, pathlib; pathlib.Path(site.getsitepackages()[0], 'eopf_runner.pth').write_text('/opt/eopf-runner\n')" \
 && python -c "import rs_dpr_service.runner.eopf_runner"

# Remove custom scripts
RUN rm -f /usr/local/bin/layer-cleanup.sh

# Create a non-root user to run as
RUN useradd --create-home --user-group --uid 1000 dask
USER dask:dask
ENV PATH=/home/dask/.local/bin:$PATH
WORKDIR /home/dask/

ENTRYPOINT ["tini", "-g", "--"]

# Set labels based on the Open Containers Initiative (OCI):
# https://github.com/opencontainers/image-spec/blob/main/annotations.md#pre-defined-annotation-keys
#
LABEL org.opencontainers.image.source="https://github.com/RS-PYTHON/rs-workflow-env"
LABEL dockerfile.url="https://github.com/RS-PYTHON/rs-workflow-env/blob/develop/docker/base/Dockerfile.dask"
